# Athena AI - Environment Configuration Template

# Security
SECRET_KEY=dev_secret_key_change_in_production_123456789

# AI Model Provider Keys (Cloud Fallbacks)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Local LLM Integration (Host or Container Ollama)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Database Configuration (PostgreSQL)
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena_secure_password
POSTGRES_DB=athena_db
DATABASE_URL=postgresql://athena:athena_secure_password@postgres:5432/athena_db

# Cache & Message Broker (Redis)
REDIS_URL=redis://redis:6379

# Vector Database (Qdrant & Chroma)
QDRANT_URL=http://qdrant:6333
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# Reverse Proxy & Free Production Domain (DuckDNS)
DOMAIN_NAME=athena-ai-enterprise.duckdns.org
